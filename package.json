{
  "name": "@traptitech/traq-markdown-it",
  "version": "8.0.0",
  "description": "Composable HTML rendering for the shared Rust Markdown parser.",
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./commonmark": {
      "types": "./dist/commonmark/index.d.ts",
      "import": "./dist/commonmark/index.js"
    },
    "./generic": {
      "types": "./dist/commonmark/extensions/index.d.ts",
      "import": "./dist/commonmark/extensions/index.js"
    },
    "./trap": {
      "types": "./dist/trap/index.d.ts",
      "import": "./dist/trap/index.js"
    },
    "./traq": {
      "types": "./dist/traq/index.d.ts",
      "import": "./dist/traq/index.js"
    },
    "./traq/v1": {
      "types": "./dist/traq/v1.d.ts",
      "import": "./dist/traq/v1.js"
    },
    "./index.css": "./dist/index.css",
    "./definitions": {
      "types": "./dist/core/definitions.d.ts",
      "import": "./dist/core/definitions.js"
    }
  },
  "files": [
    "dist/core",
    "dist/commonmark",
    "dist/trap",
    "dist/traq",
    "dist/index.css",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc && sass --no-source-map src/traq/css/index.scss dist/index.css",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit && tsc -p tests/tsconfig.json",
    "check:architecture": "node scripts/check-boundaries.mjs",
    "check:package": "node scripts/package-check.mjs",
    "format": "prettier --write src tests examples scripts README.md package.json tsconfig.json",
    "example": "node examples/traq.mts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/traPtitech/traq-markdown-it.git"
  },
  "author": "traP (https://github.com/traPtitech)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/traPtitech/traq-markdown-it/issues"
  },
  "homepage": "https://github.com/traPtitech/traq-markdown-it#readme",
  "dependencies": {
    "highlight.js": "^11.11.1",
    "katex": "^0.16.28",
    "markdown-it": "^14.1.0"
  },
  "devDependencies": {
    "@traq-markdown-parser/ts": "file:../../traq-markdown-parser/sdk",
    "@types/katex": "^0.16.8",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "26.3.0",
    "prettier": "^3.8.1",
    "sass": "^1.97.3",
    "typescript": "6.0.3"
  },
  "sideEffects": [
    "./dist/index.css"
  ],
  "private": true,
  "type": "module",
  "peerDependencies": {
    "@traq-markdown-parser/ts": "^0.1.0"
  }
}
